       "type": "eVec3"
      },
      {
       "name": "unused1",
       "type": "eFloat"
      }
     ],
     "field.direction": {
      "$link": [
       "directionallights",
       "forward"
      ]
     },
     "field.color": {
      "$link": [
       "directionallights color",
       "out"
      ]
     }
    }
   },
