          "instanceCount": 12,
          "usage": [
            "eStorage",
            "eIndirect",
            "eTransferSrc",
            "eTransferDst"
          ],
          "type": "eDeviceLocal"
        }
      },
      {
        "id": "sizer",
        "type": "ComputePipeline",
        "at": [
          440,
          60
        ],
        "inputs": {
