        "depthStencil.name": "depth",
        "depthStencil.depth": 1
      }
    },
    {
      "id": "grid target",
      "type": "Framebuffer",
      "at": [
        580,
        800
      ],
      "inputs": {
        "color[0].view": {
          "$link": [
            "grid",
            "out"
          ]
        },
        "color[0].name": "color",
        "color[0].clear": {
          "scalarType": "Float",
          "components": 4,
          "value": {
            "f": [
              0,
              0,
              0,
              0
            ]
          }
        }
      }
    },
    {
      "id": "grid shown",
      "type": "Bool",
      "at": [
