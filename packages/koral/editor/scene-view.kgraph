{
  "kgraph": 1,
  "nodes": [
    {
      "id": "about",
      "type": "Note",
      "at": [
        40,
        -120
      ],
      "inputs": {
        "text": "The editor's scene view, as the editor looks at a scene whatever its graph: its DebugViews are listed in the Scene panel (beside the scene graph's own), and 'grid' is drawn over whatever is shown while 'grid shown' is true. The editor sets 'grid shown' and the grid Draw's push.cell, push.major, push.fade, push.opacity and push.plane; and the main View is its own."
      }
    },
    {
      "id": "screen",
      "type": "Screen",
      "at": [
        40,
        40
      ],
      "inputs": {}
    },
    {
      "id": "shape",
      "type": "Primitive",
      "at": [
        40,
        160
      ],
      "inputs": {}
    },
    {
      "id": "camera",
      "type": "View",
      "at": [
        40,
        280
      ],
      "inputs": {
        "main": true
      }
    },
    {
      "id": "lens",
      "type": "Perspective",
      "at": [
        220,
        280
      ],
      "inputs": {
        "main": true,
        "aspect": {
          "$link": [
            "screen",
            "aspect"
          ]
        }
      }
    },
    {
      "id": "seen",
      "type": "MatrixMultiply",
      "at": [
        400,
        280
      ],
      "inputs": {
        "a": {
          "$link": [
            "lens",
            "out"
          ]
        },
        "b": {
          "$link": [
            "camera",
            "out"
          ]
        }
      }
    },
    {
      "id": "unseen",
      "type": "MatrixInverse",
      "at": [
        580,
        280
      ],
      "inputs": {
        "a": {
          "$link": [
            "seen",
            "out"
          ]
        }
      }
    },
    {
      "id": "view",
      "type": "ShaderBuffer",
      "at": [
        580,
        120
      ],
      "inputs": {
        "module": "koral_editor_views",
        "entry": "positionOnly",
        "parameter": "view",
        "field.viewProjection": {
          "$link": [
            "seen",
            "out"
          ]
        },
        "field.view": {
          "$link": [
            "camera",
            "out"
          ]
        }
      }
    },
    {
      "id": "grid view",
      "type": "ShaderBuffer",
      "at": [
        760,
        280
      ],
      "inputs": {
        "module": "koral_editor_grid",
        "entry": "fragment",
        "parameter": "gridView",
        "field.viewProjection": {
          "$link": [
            "seen",
            "out"
          ]
        },
        "field.inverseViewProjection": {
          "$link": [
            "unseen",
            "out"
          ]
        }
      }
    },
    {
      "id": "all",
      "type": "Entities",
      "at": [
        40,
        420
      ],
      "inputs": {}
    },
    {
      "id": "drawn",
      "type": "Filter",
      "at": [
        220,
        420
      ],
      "inputs": {
        "entities": {
          "$link": [
            "all",
            "out"
          ]
        },
        "with": [
          "Mesh"
        ]
      }
    },
    {
      "id": "picture",
      "type": "Image",
      "at": [
        400,
        560
      ],
      "inputs": {
        "format": "eRGBA8_UNORM",
        "usage": [
          "eColorAttachment",
          "eSampled",
          "eTransferSrc"
        ],
        "extent": {
          "$link": [
            "screen",
            "extent"
          ]
        }
      }
    },
    {
      "id": "view depth",
      "type": "Image",
      "at": [
        400,
        440
      ],
      "inputs": {
        "format": "eD32_SFLOAT",
        "usage": [
          "eDepthStencilAttachment"
        ],
        "extent": {
          "$link": [
            "screen",
            "extent"
          ]
        }
      }
    },
    {
      "id": "depth",
      "type": "Image",
      "at": [
        400,
        680
      ],
      "inputs": {
        "format": "eD32_SFLOAT",
        "usage": [
          "eDepthStencilAttachment",
          "eSampled"
        ],
        "extent": {
          "$link": [
            "screen",
            "extent"
          ]
        }
      }
    },
    {
      "id": "grid",
      "type": "Image",
      "at": [
        400,
        800
      ],
      "inputs": {
        "format": "eRGBA8_UNORM",
        "usage": [
          "eColorAttachment",
          "eSampled",
          "eTransferSrc"
        ],
        "extent": {
          "$link": [
            "screen",
            "extent"
          ]
        }
      }
    },
    {
      "id": "target",
      "type": "Framebuffer",
      "at": [
        580,
        560
      ],
      "inputs": {
        "color[0].view": {
          "$link": [
            "picture",
            "out"
          ]
        },
        "color[0].name": "color",
        "color[0].clear": {
          "scalarType": "Float",
          "components": 4,
          "value": {
            "f": [
              0.105,
              0.108,
              0.118,
              1
            ]
          }
        },
        "depthStencil.view": {
          "$link": [
            "view depth",
            "out"
          ]
        },
        "depthStencil.which": "Depth",
        "depthStencil.name": "depth",
        "depthStencil.depth": 1
      }
    },
    {
      "id": "depth target",
      "type": "Framebuffer",
      "at": [
        580,
        680
      ],
      "inputs": {
        "depthStencil.view": {
          "$link": [
            "depth",
            "out"
          ]
        },
