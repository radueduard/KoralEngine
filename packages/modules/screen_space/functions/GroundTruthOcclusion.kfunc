{
 "koral-function": 1,
 "purpose": "Lighting",
 "description": "How much of the sky each pixel's point sees, from the picture's `depth` alone: ground-truth ambient occlusion (Jimenez et al.), eight ways within `radius` metres, `intensity` a power on it; found at half the picture's size and blurred up to its own, kept to what is at one depth. `inverseProjection` undoes the lens, `projectionScale` is its [1][1]. `occlusion` is it (R16F, 1 open). Passes off while `idle` is not 0.",
 "tags": [
  "ambient occlusion",
  "gtao",
  "ssao",
  "occlusion",
  "screen space",
  "lighting"
 ],
 "graph": {
  "kgraph": 1,
  "nodes": [
   {
    "id": "depth",
    "type": "FunctionInput",
    "at": [
     60,
     40
    ],
    "inputs": {
     "name": "depth",
     "kind": "eImage"
    }
   },
