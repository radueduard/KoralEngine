    "type": "Subtract",
    "at": [
     840,
     40
    ],
    "inputs": {
     "a": {
      "$link": [
       "levels",
       "out"
      ]
     },
     "b": 1
    }
   },
   {
    "id": "up levels",
    "type": "Repeat",
    "at": [
     840,
     130
    ],
    "inputs": {
     "count": {
      "$link": [
       "last level",
       "out"
      ]
     }
    }
