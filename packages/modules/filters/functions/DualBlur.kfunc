{
 "koral-function": 1,
 "purpose": "Post",
 "description": "A picture blurred as wide as `levels` halvings: the dual filter (Bj\u00f8rge's), down a chain of pictures each half the last and back up it. `blurred` is the top of the way up: half the picture's size, to be read with a linear sampler.",
 "tags": [
  "blur",
  "dual filter",
  "dual kawase",
  "wide blur",
  "post",
  "filter"
 ],
 "graph": {
  "kgraph": 1,
  "nodes": [
   {
    "id": "picture",
    "type": "FunctionInput",
    "at": [
     60,
     40
    ],
    "inputs": {
     "name": "picture",
     "kind": "eImage"
    }
   },
   {
    "id": "levels",
    "type": "FunctionInput",
    "at": [
     60,
     130
    ],
    "inputs": {
     "name": "levels",
     "kind": "eValue",
     "default": 4
    }
   },
   {
    "id": "size",
    "type": "ImageExtent",
    "at": [
     320,
     40
    ],
    "inputs": {
     "image": {
      "$link": [
       "picture",
       "out"
      ]
     }
    }
   },
   {
    "id": "half",
    "type": "Divide",
    "at": [
     320,
     130
    ],
    "inputs": {
     "a": {
      "$link": [
       "size",
       "out"
      ]
     },
     "b": [
      2,
      2,
      1
     ]
    }
   },
   {
    "id": "linear",
    "type": "Sampler",
    "at": [
     320,
     220
    ],
    "inputs": {
     "minFilter": "eLinear",
     "magFilter": "eLinear",
     "addressModeU": "eClampToEdge",
     "addressModeV": "eClampToEdge"
    }
   },
   {
    "id": "down chain",
    "type": "Image",
    "at": [
     580,
     40
    ],
    "inputs": {
     "format": "eRGBA16_SFLOAT",
     "usage": [
      "eStorage",
      "eSampled",
      "eTransferSrc"
     ],
     "extent": {
      "$link": [
       "half",
       "out"
      ]
     },
     "mipLevels": {
      "$link": [
       "levels",
       "out"
      ]
     }
    }
   },
   {
    "id": "up chain",
    "type": "Image",
    "at": [
     580,
     130
    ],
    "inputs": {
     "format": "eRGBA16_SFLOAT",
     "usage": [
      "eStorage",
      "eSampled",
      "eTransferSrc"
     ],
     "extent": {
      "$link": [
       "half",
       "out"
      ]
     },
     "mipLevels": {
      "$link": [
       "levels",
       "out"
      ]
     }
    }
   },
   {
    "id": "down levels",
    "type": "Repeat",
    "at": [
     840,
     40
    ],
    "inputs": {
     "count": {
      "$link": [
       "levels",
       "out"
      ]
     }
    }
   },
   {
    "id": "down level",
    "type": "ImageView",
    "at": [
     840,
     130
    ],
    "inputs": {
     "image": {
      "$link": [
       "down chain",
       "out"
      ]
     },
     "baseMipLevel": {
      "$link": [
       "down levels",
       "index"
      ]
     },
     "mipLevelCount": 1
    }
   },
   {
    "id": "source view",
    "type": "ImageView",
    "at": [
     840,
     220
    ],
    "inputs": {
     "image": {
      "$link": [
       "picture",
       "out"
      ]
     }
    }
   },
   {
    "id": "level above",
    "type": "Previous",
    "at": [
     840,
     310
    ],
    "inputs": {
     "of": "down level",
     "first": "source view"
    }
   },
   {
    "id": "down",
    "type": "ComputePipeline",
    "at": [
     1100,
     40
    ],
    "inputs": {
     "compute.module": "filters_passes",
     "compute.entry": "dualDown",
     "param.source": {
      "$link": [
