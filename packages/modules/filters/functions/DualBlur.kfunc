      "$link": [
       "up levels",
       "reverse"
      ]
     },
     "mipLevelCount": 1
    }
   },
   {
    "id": "smallest",
    "type": "Element",
    "at": [
     840,
     310
    ],
    "inputs": {
     "of": "down level"
    }
   },
   {
    "id": "level below",
    "type": "Previous",
    "at": [
     840,
