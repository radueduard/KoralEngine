# Build trees
/build/
/cmake-build-*/

# IDE
/.idea/
/.vs/
/.vscode/

# Machine-local presets the Hub writes
CMakePresets.json
CMakeUserPresets.json
bin/
obj/
.gradle/
bindings/kotlin/**/build/
.kotlin/

# Downloaded models a project uses (forward-plus: Intel's New Sponza packages), too large for the repository
/projects/*/assets/

# An 18 MB environment map, kept locally only
packages/koral/editor/studio_small_09_4k.exr

# What the engine keeps of an official module while a project uses it: ids of its files, made on each machine
packages/modules/*/.koral/
