<!-- Written by the Koral Engine editor, for an editor of code to know the engine's names by. Nothing builds it. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="scripts/**/*.cs" />
    <Compile Include="/mnt/w/KoralEngine/packages/koral/scripts/*.cs" Link="koral/%(Filename)%(Extension)" />
    <Reference Include="Koral.Engine"><HintPath>/mnt/w/KoralEngine/cmake-build-release/dotnet/Koral.Engine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Koral"><HintPath>/mnt/w/KoralEngine/cmake-build-release/dotnet/Koral.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
